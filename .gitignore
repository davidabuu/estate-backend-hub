.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# NuGet
*.nupkg
*.snupkg
packages/
*.pdb
*.cache
*.nuspec

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Publish
*.pubxml
*.publishproj

# Node
node_modules/
npm-debug.log
yarn-error.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store
Desktop.ini

# Logs
logs/
*.log