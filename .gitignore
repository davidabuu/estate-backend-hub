## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# NuGet
*.nupkg
*.snupkg
packages/
*.pdb
*.cache
*.nuspec

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Publish
*.pubxml
*.publishproj

# Node
node_modules/
npm-debug.log
yarn-error.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store
Desktop.ini

# Logs
logs/
*.log

# ==========================================
# ✅ Environment & Secrets (Add these!)
# ==========================================

# Production appsettings (contains secrets)
**/appsettings.Production.json
**/appsettings.Development.json

# User secrets (Visual Studio)
**/secrets.json

# Environment variables
.env
.env.local
.env.production

# Connection strings / sensitive config
**/appsettings.Local.json
**/appsettings.Secrets.json

# Docker secrets
**/.docker/secrets/
**/docker-compose.override.yml